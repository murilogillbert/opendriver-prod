OPEN_DRIVER_PROD_DIR=/root/opendriver-prod
OPEN_DRIVER_REPO_URL=https://github.com/murilogillbert/opendriver.git
OPEN_DRIVER_APP_DIR=/root/opendriver
OPEN_DRIVER_WEBROOT=/var/www/opendriver
OPEN_DRIVER_DOMAIN=opendriver.com.br
OPEN_DRIVER_WWW_DOMAIN=www.opendriver.com.br

GIT_USER_NAME=Open Driver Deploy
GIT_USER_EMAIL=deploy@opendriver.com.br
GIT_DEFAULT_BRANCH=main

APP_ENV=production
APP_PORT=3001
WEB_PORT=8080
PUBLIC_API_BASE_URL=/api

SQLSERVER_HOST=sqlserver
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=OpenDriver
# Replace with a unique strong password — the API refuses to boot in production with the placeholder below.
SQLSERVER_PASSWORD=Change_this_Strong_Password_123!
SQLSERVER_USER=sa

# REQUIRED in production. Generate with `openssl rand -base64 48`. Must be >= 32 chars and not the placeholder.
JWT_SECRET=change_this_jwt_secret
# Admin token lifespan (short on purpose). Use ADMIN_TOKEN_TTL=30m or 1h for stricter sessions.
ADMIN_TOKEN_TTL=2h
USER_TOKEN_TTL=7d

# REQUIRED in production. One-shot shared secret to authorize POST /api/auth/bootstrap-admin.
# Set it once when seeding the first admin and rotate (or remove) afterwards.
ADMIN_BOOTSTRAP_TOKEN=

# REQUIRED in production. Comma-separated allowlist of origins. Wildcard '*' is rejected at boot.
CORS_ORIGIN=https://opendriver.com.br,https://www.opendriver.com.br
UPLOAD_DIR=/app/uploads
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=

CLOUDFLARE_TUNNEL_NAME=opendriver
CLOUDFLARE_TUNNEL_ID=
