# ---- Repositórios / deploy ----
HUB_PROD_DIR=/root/opendriver-prod
# URL do repositório do Hub (substitua pelo seu remoto):
HUB_REPO_URL=https://github.com/SEU_USUARIO/hub.git
HUB_APP_DIR=/root/hub
HUB_DOMAIN=seudominio.com.br
HUB_WWW_DOMAIN=www.seudominio.com.br

GIT_USER_NAME=OpenDriverHub Deploy
GIT_USER_EMAIL=deploy@seudominio.com.br
GIT_DEFAULT_BRANCH=main

# ---- App (.NET / Vite) ----
ASPNETCORE_ENVIRONMENT=Production
# Base da API consumida pelo front (mantém /api/v1 — o Nginx faz o proxy).
PUBLIC_API_BASE_URL=/api/v1
# Seed de dados demo (parceiros/produtos/clientes fictícios).
# MANTENHA false em produção: o lançamento é enxuto, só com o admin.
Seed__Enabled=false
# Admin garantido no 1º boot (criado só se ainda não existir; não reseta a
# senha de um admin já existente). Troque a senha antes do lançamento.
Seed__AdminEmail=admin@opendriverhub.com
Seed__AdminPassword=Bababobo!@#

# ---- Banco (SQL Server) ----
SQLSERVER_DATABASE=OpenDriverHub
# Troque por uma senha forte e única.
SQLSERVER_PASSWORD=Troque_esta_senha_forte_123!
# A ConnectionStrings__Default é montada no docker-compose.yml a partir
# de SQLSERVER_PASSWORD/SQLSERVER_DATABASE — não precisa defini-la aqui.

# ---- Autenticação (JWT) ----
# OBRIGATÓRIO em produção. Gere com: openssl rand -base64 48  (>= 32 chars)
Jwt__Secret=GERAR_UM_SEGREDO_FORTE_AQUI
Jwt__AccessTtl=02:00:00
Jwt__RefreshTtl=7.00:00:00

# ---- CORS ----
# Lista separada por vírgula. Não use '*'.
Cors__Origins=https://seudominio.com.br,https://www.seudominio.com.br

# ---- Pagamento ----
# mock (default, sem credenciais) ou mercadopago (usa o token configurado).
Payment__Provider=mock
Payment__WebhookRequireSignature=true
Payment__WebhookToleranceSeconds=300

# ---- Uploads ----
Storage__UploadDir=/app/uploads
Storage__MaxImageBytes=5242880

# ---- Rate limiting (/auth) ----
RateLimit__Auth__PermitLimit=5
RateLimit__Auth__WindowSeconds=60

# ---- Credenciais de integração (OPCIONAIS) ----
# Podem ficar vazias: são editáveis em runtime em Admin -> Integrações
# (o valor salvo no banco sobrepõe estes defaults do .env).
MercadoPago__AccessToken=
MercadoPago__PublicKey=
MercadoPago__WebhookSecret=
WhatsApp__Token=
WhatsApp__PhoneNumber=
Email__GmailUser=
Email__GmailAppToken=
Email__FromName=
# Assistente IA — sem a chave, o chatbot usa o modo local (regras).
Groq__ApiKey=
Groq__Model=llama-3.3-70b-versatile

# ---- Cloudflare (já configurado no servidor — não alterar) ----
CLOUDFLARE_TUNNEL_NAME=opendriver
CLOUDFLARE_TUNNEL_ID=
