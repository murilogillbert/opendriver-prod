# OpenDriverHub production helpers
export HUB_PROD_DIR="${HUB_PROD_DIR:-/root/opendriver-prod}"
export HUB_APP_DIR="${HUB_APP_DIR:-/root/hub}"

alias odh-prod='cd "$HUB_PROD_DIR"'
alias odh-app='cd "$HUB_APP_DIR"'
alias odh-update='cd "$HUB_PROD_DIR" && bash update.sh'
alias odh-ps='cd "$HUB_PROD_DIR" && docker compose --env-file .env ps'
alias odh-logs-api='docker logs -f opendriverhub-api'
alias odh-logs-web='docker logs -f opendriverhub-web'
alias odh-logs-sql='docker logs -f opendriverhub-sqlserver'
alias odh-logs-nginx='docker logs -f opendriverhub-nginx'

# Gera um segredo forte para Jwt__Secret. Cole no .env.
alias odh-gen-secret='openssl rand -base64 48 | tr -d "\n"; echo'
